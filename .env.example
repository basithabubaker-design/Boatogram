# --- Database -----------------------------------------------------------
# Used by the running app (pooled connections are fine, e.g. Neon's -pooler host).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boatogram?schema=public"
# Optional: a direct/unpooled connection string, used only for running
# migrations (`prisma migrate deploy`/`dev`). Required on providers like Neon
# where the pooled connection (PgBouncer, transaction mode) breaks Prisma
# Migrate's session-level operations. Same host as DATABASE_URL but without
# "-pooler" in the hostname. Falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=""

# --- Auth -----------------------------------------------------------------
# Random 32+ byte secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# --- Platform commission ----------------------------------------------------
# Percentage (0-100) of every booking retained as platform commission.
PLATFORM_COMMISSION_PERCENT=15

# --- Razorpay (payments) ---------------------------------------------------
# Create a Razorpay account and enable Razorpay Route for marketplace split
# settlements: https://razorpay.com/docs/payments/route/
# Leave these unset in development to run the app with payments disabled —
# the booking flow will surface a clear "payments not configured" error
# instead of faking a successful payment.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Configured in the Razorpay Dashboard under Webhooks; used to verify the
# X-Razorpay-Signature header on incoming webhook requests.
RAZORPAY_WEBHOOK_SECRET=""

# --- Notifications (email) -------------------------------------------------
# Optional. If unset, notifications are stored in-app and logged to the
# server console instead of being emailed.
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="Boatogram <notifications@boatogram.example>"

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
